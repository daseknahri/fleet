 "kind": "Security self-review DRAFT (codebase review + live spot-proofs on the local dev stack; not a penetration test, no external scanners used)",
 "threatModel": {
  "assets": [
   "agency financial data (cash sessions/movements, rental payments, invoices, approvals)",
   "contract evidence files (inspections, signatures, receipts) in private storage",
   "user accounts and session tokens",
   "booking/customer PII"
  ],
  "actors": [
   "unauthenticated internet user (customer frontend surface)",
   "authenticated customer",
   "agency staff with role-scoped membership (owner/manager/counterAgent/accountant/mechanic/readOnly)",
   "agency supplier principal (owner of own agency scope)",
   "platform admin"
  ],
  "trustBoundaries": [
   "browser -> backend API (JWT cookie auth, origin-selected cookie names)",
   "agency scope: every Gestion Auto route gated by verifyToken + agency permission; controllers re-scope queries by agency",
   "public capability flows: checkout/payment status keyed by provider session/order ids",
   "private files: downloads only through verifyToken-gated document routes; avatars/car images are public CDN by design"
  ],
  "topThreats": [
   "cross-agency data access (IDOR) - mitigated by agency scoping + permission matrix, spot-proven",
   "privilege escalation via staff roles - mitigated by role permission matrix, spot-proven",
   "unauthenticated admin creation - route disabled in code, verified 404",
   "session theft - httpOnly + SameSite=Strict cookies; Secure flag is a production configuration gate",
   "malicious uploads - extension allowlist + private storage; content sniffing absent (F-SEC-2)",
   "credential stuffing - Redis token-bucket rate limiter on auth endpoints"
  ]
 },
