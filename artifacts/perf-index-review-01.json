  {
   "query": "bookingController.getBookings core $match (supplier._id $in, status $in, expireAt null) + sort createdAt:-1",
   "plan": "SORT <- FETCH <- IXSCAN(supplier._id_1_status_1_expireAt_1)",
   "verdict": "Filter fully indexed; sort in memory over the agency active set (bounded)."
  },
  {
   "query": "reportController RentalPayment $match (supplier, date range, status posted)",
   "plan": "FETCH <- IXSCAN(supplier_1_status_1_date_-1)",
   "verdict": "Fully indexed."
  },
  {
   "query": "reportController Booking overlap find (supplier, from<to, to>from, status $nin)",
   "plan": "FETCH <- IXSCAN(supplier_1), 8 examined / 6 returned",
   "verdict": "Supplier prefix used; two-sided date ranges are inherently single-range boundable; filtered remainder is the agency subset."
  },
  {
   "query": "reportController Invoice $match (supplier, status $ne, createdAt range)",
   "plan": "FETCH <- IXSCAN(supplier_1_createdAt_-1)",
   "verdict": "Fully indexed."
  },
  {
   "query": "reportController MaintenanceExpense $match (supplier, date range)",
   "plan": "covered by supplier_1_date_-1 (model/live index present; same shape as RentalPayment match)",
   "verdict": "Indexed."
