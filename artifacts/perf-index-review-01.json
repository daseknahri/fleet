  {
   "query": "approvalController list find(supplier scope) + sort createdAt:-1",
   "plan": "SORT <- FETCH <- IXSCAN(supplier_1), 4 examined / 4 returned",
   "verdict": "Prefix indexed; sort in memory; endpoint returns the full agency list without pagination (see finding F-PERF-2)."
