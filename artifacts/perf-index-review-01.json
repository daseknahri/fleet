 "findings": [
  {
   "id": "F-PERF-1",
   "severity": "low",
   "text": "Booking list sorts createdAt in memory after the (supplier._id, status, expireAt) IXSCAN. Candidate if a single agency active-booking volume grows: compound (supplier._id, status, createdAt:-1). Not added: no production-volume evidence; current filter index is unambiguous and sufficient at observed scale."
  },
  {
   "id": "F-PERF-2",
   "severity": "low",
   "text": "Approvals list endpoint returns the full agency list (sort createdAt:-1, in-memory) with no pagination and only a supplier prefix index. Candidate when approval volume grows: pagination + (supplier, createdAt:-1). Product/perf decision, not an unambiguous defect."
  },
  {
   "id": "F-PERF-3",
   "severity": "info",
   "text": "Booking keyword search uses unanchored case-insensitive regex over supplier.fullName / driver.fullName / car.name; single-field indexes exist but unanchored regex cannot use them effectively. Bounded by the supplier+status pre-filter. Revisit only if search latency is reported at volume."
  },
  {
   "id": "F-PERF-4",
   "severity": "info",
   "text": "RentalPayment collection holds 0 documents in the dev data, so report aggregation plans are verified by query shape and index presence, not by volume."
  }
