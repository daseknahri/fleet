# General
NODE_ENV=production

# Backend server
BC_PORT=4002
BC_HTTPS=false
BC_PRIVATE_KEY=/etc/ssl/bookcars.key
BC_CERTIFICATE=/etc/ssl/bookcars.crt

# MongoDB
BC_DB_URI=mongodb://admin:PLACEHOLDER_IN_COOLIFY@mongo:27017/bookcars?authSource=admin&appName=bookcars&replicaSet=rs0
BC_DB_SSL=false
BC_DB_SSL_CERT=/etc/ssl/bookcars.crt
BC_DB_SSL_CA=/etc/ssl/bookcars.ca.pem
BC_DB_DEBUG=false

# Redis
BC_REDIS_URL=redis://redis:6379

# Rate Limiter
BC_RATE_LIMIT_CAPACITY=100
BC_RATE_LIMIT_REFILL_RATE_MS=2000

# Auth
BC_COOKIE_SECRET=REPLACE_IN_COOLIFY_ENV
BC_AUTH_COOKIE_DOMAIN=localhost
BC_ADMIN_HOST=http://localhost:3002/
BC_FRONTEND_HOST=https://gestionauto.ibnbatoutaweb.com/
BC_JWT_SECRET=REPLACE_IN_COOLIFY_ENV
BC_JWT_EXPIRE_AT=86400
BC_TOKEN_EXPIRE_AT=86400
BC_APPLE_CLIENT_ID_WEB=
BC_APPLE_CLIENT_ID_MOBILE=
BC_GOOGLE_CLIENT_ID=
BC_GOOGLE_MOBILE_CLIENT_ID=
BC_FACEBOOK_APP_ID=
BC_FACEBOOK_APP_SECRET=REPLACE_IN_COOLIFY_ENV

# Currency
BC_BASE_CURRENCY=MAD

# Email (SMTP) - local Mailpit container
BC_SMTP_HOST=mailpit
BC_SMTP_PORT=1025
BC_SMTP_USER=mailpit
BC_SMTP_PASS=REPLACE_IN_COOLIFY_ENV
BC_SMTP_FROM=no-reply@fleetrent.local

# CDN (File storage)
BC_CDN_ROOT=/var/www/cdn
BC_CDN_USERS=/var/www/cdn/bookcars/users
BC_CDN_TEMP_USERS=/var/www/cdn/bookcars/temp/users
BC_CDN_CARS=/var/www/cdn/bookcars/cars
BC_CDN_TEMP_CARS=/var/www/cdn/bookcars/temp/cars
BC_CDN_LOCATIONS=/var/www/cdn/bookcars/locations
BC_CDN_TEMP_LOCATIONS=/var/www/cdn/bookcars/temp/locations
BC_CDN_CONTRACTS=/var/www/cdn/bookcars/contracts
BC_CDN_TEMP_CONTRACTS=/var/www/cdn/bookcars/temp/contracts
BC_CDN_LICENSES=/var/www/cdn/bookcars/licenses
BC_CDN_TEMP_LICENSES=/var/www/cdn/bookcars/temp/licenses

# Localization
BC_DEFAULT_LANGUAGE=en

# Business Rules
BC_MINIMUM_AGE=21

# Expo
BC_EXPO_ACCESS_TOKEN=REPLACE_IN_COOLIFY_ENV

# Stripe (not configured - manual payment flow)
BC_STRIPE_SECRET_KEY=REPLACE_IN_COOLIFY_ENV
BC_STRIPE_SESSION_EXPIRE_AT=82800

# PayPal (not configured)
BC_PAYPAL_SANDBOX=true
BC_PAYPAL_CLIENT_ID=
BC_PAYPAL_CLIENT_SECRET=REPLACE_IN_COOLIFY_ENV

# Admin
BC_ADMIN_EMAIL=admin@fleetrent.local

# Google reCAPTCHA
BC_RECAPTCHA_SECRET=REPLACE_IN_COOLIFY_ENV

# Misc
BC_WEBSITE_NAME=FleetRent
BC_TIMEZONE=Africa/Casablanca

# IPInfo (Geo lookup)
BC_IPINFO_API_KEY=REPLACE_IN_COOLIFY_ENV
BC_IPINFO_DEFAULT_COUNTRY=US

# Language cleanup job
BC_BATCH_SIZE=1000

# Sentry
BC_ENABLE_SENTRY=false
BC_SENTRY_DSN_BACKEND=REPLACE_IN_COOLIFY_ENV
BC_SENTRY_TRACES_SAMPLE_RATE=1.0

BC_CDN_MAINTENANCE=/var/www/cdn/bookcars/maintenance
BC_CDN_TEMP_MAINTENANCE=/var/www/cdn/bookcars/temp/maintenance
BC_API_HOST=https://api.gestionauto.ibnbatoutaweb.com
